# ARR stack deployment settings. Copy to .env and keep that file private.
COMPOSE_PROJECT_NAME=media-stack

# Identity and locale. Match the host user/group that owns /mnt/media.
PUID=0
PGID=0
TZ=Europe/Madrid

# Runtime configuration stays inside the checkout in ignored service folders.
# Do not commit these directories or delete them with `git clean -fdx`.
CONFIG_ROOT=.

# Keep torrents and libraries under the same filesystem so Sonarr/Radarr can
# use hardlinks and atomic moves.
DATA_ROOT=/mnt/media

# Public names and shared Docker networks.
MEDIA_DOMAIN=ahome.quest
TRAEFIK_NETWORK=frontend
TAILSCALE_NETWORK=backend

# Traefik. The image is pinned in traefik/traefik-compose.yml so Renovate can update it.
# The Cloudflare token needs DNS edit permission for ahome.quest.
TRAEFIK_CONFIG_ROOT=./config
TRAEFIK_ACME_EMAIL=admin@example.invalid
CF_DNS_API_TOKEN=replace-me

# Tailscale sidecar. Never commit a real auth key.
# This is resolved relative to the Compose project directory.
TS_STATE_DIR=./tailscale/config
TS_AUTHKEY=replace-me
TS_EXTRA_ARGS=--accept-routes --exit-node=100.0.0.1 --exit-node-allow-lan-access
# Kernel TUN mode is required so every app in the shared namespace uses the exit node.
TS_USERSPACE=false
