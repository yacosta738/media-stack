# ARR stack deployment settings. Copy to .env and keep that file private.
COMPOSE_PROJECT_NAME=media-stack

# Identity and locale. Match the host user/group that owns /mnt/media.
PUID=0
PGID=0
TZ=Europe/Madrid

# Existing host paths. Keep torrents and libraries under the same filesystem
# so Sonarr/Radarr can use hardlinks and atomic moves.
CONFIG_ROOT=/root/home/media
DATA_ROOT=/mnt/media

# Public names and shared Docker networks.
MEDIA_DOMAIN=ahome.quest
TRAEFIK_NETWORK=frontend
TAILSCALE_NETWORK=backend

# Traefik. The Cloudflare token needs DNS edit permission for ahome.quest.
TRAEFIK_IMAGE=traefik:2.10.4
TRAEFIK_CONFIG_ROOT=./config
TRAEFIK_ACME_EMAIL=admin@example.invalid
CF_DNS_API_TOKEN=replace-me

# Tailscale sidecar. Never commit a real auth key.
TS_STATE_DIR=/root/home/vpn/ts-authkey
TS_AUTHKEY=replace-me
TS_EXTRA_ARGS=--accept-routes --exit-node=100.0.0.1 --exit-node-allow-lan-access
