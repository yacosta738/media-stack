{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "enabledManagers": [
    "docker-compose"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|\\/)docker-compose[^/]*\\.ya?ml$/",
      "/(^|\\/)[^/]+-compose\\.ya?ml$/"
    ]
  },
  "dependencyDashboard": true,
  "rebaseWhen": "conflicted",
  "rangeStrategy": "pin",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "schedule": [
    "before 5am on monday"
  ],
  "packageRules": [
    {
      "description": "Group non-breaking Docker image updates",
      "matchManagers": [
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pinDigest"
      ],
      "groupName": "docker image updates",
      "automerge": false
    },
    {
      "description": "Keep major image upgrades explicit",
      "matchManagers": [
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "dependencies",
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
